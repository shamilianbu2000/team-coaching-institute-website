# Copy to .env.local for local development, and add the same variables in your hosting provider (e.g. Vercel → Project → Settings → Environment Variables).
# NEXT_PUBLIC_* values are embedded in the browser bundle at build time – never put secrets here.

# REQUIRED for the admission form: your Formspree form endpoint (see docs/FORMSPREE_SETUP.md)
NEXT_PUBLIC_FORMSPREE_ENDPOINT=YOUR_FORMSPREE_ENDPOINT

# REQUIRED in production: the public URL of the site (used for canonical URLs, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional: Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Analytics is off when empty.
NEXT_PUBLIC_GA_ID=

# Optional: Google Search Console HTML-tag verification token (content value only)
NEXT_PUBLIC_GSC_VERIFICATION=

# Optional overrides (defaults are the numbers verified from public listings)
# NEXT_PUBLIC_PHONE_DISPLAY=063814 66472
# NEXT_PUBLIC_PHONE_TEL=+916381466472
# WhatsApp number in international format WITHOUT "+" – confirm with the client that this number uses WhatsApp
# NEXT_PUBLIC_WHATSAPP_NUMBER=916381466472
# NEXT_PUBLIC_CONTACT_EMAIL=

# Optional social profiles – none were found for the institute; add once the client confirms them
# NEXT_PUBLIC_INSTAGRAM_URL=
# NEXT_PUBLIC_YOUTUBE_URL=
# NEXT_PUBLIC_FACEBOOK_URL=
